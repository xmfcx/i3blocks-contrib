#!/usr/bin/env bash
# volume-pipewire: PipeWire compatible script for i3blocks
# Replicates legacy pacmd behavior using pactl and wpctl

# --- CONFIGURATION ---
# Use symbols from environment or default to FontAwesome
AUDIO_HIGH_SYMBOL=${AUDIO_HIGH_SYMBOL:-'  '}
AUDIO_MED_SYMBOL=${AUDIO_MED_SYMBOL:-'  '}
AUDIO_LOW_SYMBOL=${AUDIO_LOW_SYMBOL:-'  '}
AUDIO_MUTED_SYMBOL=${AUDIO_MUTED_SYMBOL:-'  '}

AUDIO_MED_THRESH=${AUDIO_MED_THRESH:-50}
AUDIO_DELTA=${AUDIO_DELTA:-5}

# Use colors from i3blocks config, or default if missing
COLOR_ACTIVE=${COLOR_ACTIVE:-"#ffffff"}
COLOR_MUTED=${COLOR_MUTED:-"#a0a0a0"}

# --- FUNCTION: Switch Sink (Next/Prev) ---
function switch_sink {
    DIRECTION=$1 # 1 for Next, -1 for Prev

    # 1. Get list of Sink IDs (clean numerical list)
    SINKS=($(pactl list short sinks | awk '{print $1}'))
    
    # 2. Get current default sink name and find its ID
    CURRENT_NAME=$(pactl get-default-sink)
    # We grep strictly to ensure we match the ID belonging to the exact name
    CURRENT_ID=$(pactl list short sinks | grep -F "$CURRENT_NAME" | awk '{print $1}' | head -n 1)

    # 3. Find array index of current sink
    CURRENT_IDX=-1
    for i in "${!SINKS[@]}"; do
        if [[ "${SINKS[$i]}" == "$CURRENT_ID" ]]; then
            CURRENT_IDX=$i
            break
        fi
    done

    # 4. Calculate Target Index (Cyclic)
    NUM_SINKS=${#SINKS[@]}
    # If current not found (weird state), default to 0
    [[ $CURRENT_IDX -eq -1 ]] && CURRENT_IDX=0
    
    TARGET_IDX=$(( (CURRENT_IDX + DIRECTION) % NUM_SINKS ))
    # Bash modulo can be negative, fix it for "Previous" logic
    if (( TARGET_IDX < 0 )); then TARGET_IDX=$((TARGET_IDX + NUM_SINKS)); fi

    TARGET_ID=${SINKS[$TARGET_IDX]}
    
    # 5. Get Name of Target to set as default
    TARGET_NAME=$(pactl list short sinks | awk -v id="$TARGET_ID" '$1 == id {print $2}')

    # 6. Apply Switch
    pactl set-default-sink "$TARGET_NAME"
    
    # 7. Move all current audio streams to the new sink
    pactl list short sink-inputs | cut -f1 | while read stream; do
        pactl move-sink-input "$stream" "$TARGET_ID"
    done
}

# --- HANDLE CLICK EVENTS ---
case "$BLOCK_BUTTON" in
    1) switch_sink 1 ;;       # Left Click: Next Sink
    2) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;; # Middle Click: Mute
    3) switch_sink -1 ;;      # Right Click: Prev Sink
    4) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ ;;  # Scroll Up
    5) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;  # Scroll Down
esac

# --- GATHER DISPLAY DATA ---

# 1. Get Volume & Mute Status (using wpctl for speed/accuracy)
VOL_INFO=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
# Example Output: "Volume: 0.45 [MUTED]"
VOL_VAL=$(echo "$VOL_INFO" | awk '{print int($2 * 100)}')
IS_MUTED=$(echo "$VOL_INFO" | grep -o "MUTED")

# 2. Get Friendly Device Name
# We parse `pactl list sinks` to find the description of the current default
DEFAULT_NAME=$(pactl get-default-sink)
# This sed command extracts the "Description" line for the matching sink
DESC=$(pactl list sinks | grep -A 50 "Name: $DEFAULT_NAME" | grep -m 1 "Description:" | sed 's/^\s*Description: //')
ID=$(pactl list short sinks | grep -F "$DEFAULT_NAME" | awk '{print $1}')

# Fallback if description fails
[[ -z "$DESC" ]] && DESC="$DEFAULT_NAME"

# Shorten description if it's too long (optional)
if [[ ${#DESC} -gt 5 ]]; then
    DESC="${DESC:0:4}.."
fi

# --- FORMAT OUTPUT ---

if [[ -n "$IS_MUTED" ]]; then
    ICON=$AUDIO_MUTED_SYMBOL
    COLOR=$COLOR_MUTED
else
    if [[ "$VOL_VAL" -gt $AUDIO_MED_THRESH ]]; then
        ICON=$AUDIO_HIGH_SYMBOL
    elif [[ "$VOL_VAL" -gt 0 ]]; then
        ICON=$AUDIO_MED_SYMBOL
    else
        ICON=$AUDIO_LOW_SYMBOL
    fi
    COLOR=$COLOR_ACTIVE
fi

# Output: ICON VOL% [NAME]
echo "<span color='$COLOR'>$ICON $VOL_VAL% [$DESC]</span>"
echo "<span color='$COLOR'>$ICON $VOL_VAL% [$DESC]</span>"
echo "$COLOR"
