#!/usr/bin/env bash

# --- CONFIGURATION ---
STEP_SIZE=10
STATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/gammastep-brightness"
CONFIG_FILE="$HOME/.config/gammastep/config.ini"

# --- INIT STATE ---
[ -f "$STATE_FILE" ] || echo 100 > "$STATE_FILE"
BRIGHT=$(cat "$STATE_FILE")

# --- HANDLE INPUT ---
case "$BLOCK_BUTTON" in
    1) BRIGHT=100 ;;                  # Left click → max
    3) BRIGHT=10 ;;                   # Right click → safe min
    4) BRIGHT=$((BRIGHT + STEP_SIZE)) ;; # Scroll up
    5) BRIGHT=$((BRIGHT - STEP_SIZE)) ;; # Scroll down
esac

# Clamp 10–100
(( BRIGHT > 100 )) && BRIGHT=100
(( BRIGHT < 10  )) && BRIGHT=10

# Persist desired state
echo "$BRIGHT" > "$STATE_FILE"

# --- OUTPUT (always) ---
echo " $BRIGHT%"

# --- APPLY ONLY ON USER ACTION ---
[ -z "$BLOCK_BUTTON" ] && exit 0

# Convert to float
VAL=$(awk -v b="$BRIGHT" 'BEGIN { printf "%.1f", b/100 }')

# Restart gammastep cleanly
killall -q gammastep
nohup gammastep -x >/dev/null 2>&1 &
killall -q gammastep
nohup gammastep -c "$CONFIG_FILE" -b "$VAL:$VAL" >/dev/null 2>&1 &

exit 0
